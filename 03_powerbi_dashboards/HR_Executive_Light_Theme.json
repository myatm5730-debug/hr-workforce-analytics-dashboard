{
  "$schema": "https://powerbi.microsoft.com/download/theme/reportThemeSchema.json",
  "name": "HR Executive Light Blue & White Theme",
  "dataColors": [
    "#0078D7",
    "#2563EB",
    "#0F3C88",
    "#00B4D8",
    "#10B981",
    "#F59E0B",
    "#EF4444",
    "#8B5CF6",
    "#64748B"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#2563EB",
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "maximum": "#0078D7",
  "center": "#F59E0B",
  "minimum": "#E2E8F0",
  "null": "#CBD5E1",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Bold",
      "color": "#0F172A"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#334155"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#475569"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#EBF3FA"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#93C5FD"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 70
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "bold": true,
            "alignment": "left"
          }
        ],
        "legend": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#475569"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#475569"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontFamily": "Segoe UI Bold",
            "fontSize": 24
          }
        ],
        "label": [
          {
            "fontColor": {
              "solid": {
                "color": "#475569"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#2563EB"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F0F7FF"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#2563EB"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#EBF3FA"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F0F7FF"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    }
  }
}